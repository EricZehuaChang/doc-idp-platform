# ==================== 智能文档处理平台 · 现场配置 ====================
# 改完执行 ./idp.sh restart 生效。每行“名称=值”，等号两边不要加空格，值不要加引号。

# ---------- 访问 ----------
# 平台端口（行内网络已按 8080 开通）
IDP_PORT=8080
# 浏览器访问地址，填本机 IP 和端口
IDP_PUBLIC_URL=http://10.12.200.188:8080

# ---------- 首个管理员（只在第一次启动、系统里还没有任何账号时创建）----------
IDP_ADMIN_EMAIL=admin@example.com
# 必填：管理员登录密码，至少 8 位
IDP_ADMIN_PASSWORD=

# ---------- 抽取大模型（行内 DeepSeek-V4-Flash，OpenAI 兼容接口）----------
# 地址写到 /v1 为止，例如 http://10.1.2.3:8000/v1
LLM_BASE_URL=
LLM_MODEL=deepseek-v4-flash
# 没有密钥就留空
LLM_API_KEY=
# 关闭思考的参数（JSON），按行内服务说明填；不确定先留 {}，./idp.sh check 会提示
LLM_EXTRA_BODY={}

# ---------- 多模态模型（行内千问多模态，扫描件和图片走它）----------
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_EXTRA_BODY={}

# ---------- OCR 识别模型（可选，行内 PaddleOCR-VL）----------
# 填了模型名，扫描件和图片就交给它识别文字；地址和密钥沿用上面多模态那组
# 留空则扫描件走上面的多模态模型
OCR_MODEL=
# 识别指令，PaddleOCR-VL 用 OCR:，一般不用改
OCR_PROMPT=OCR:

# ---------- 固定项，不要改 ----------
IDP_AUTH_MODE=on
IDP_LICENSE_REQUIRED=true
IDP_DEPLOY_TIER=lite
IDP_FAST_VISION_PROVIDER=vision-qwen
