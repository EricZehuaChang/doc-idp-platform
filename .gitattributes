# Built frontend bundles are tracked ON PURPOSE: releases ship via `git archive
# HEAD` and the server never runs npm build, so app/webdist must stay in git.
# linguist still must not count minified bundles as source — mark generated
# (GitHub excludes linguist-generated paths from the language bar).
app/webdist/** linguist-generated=true
frontend/dist/** linguist-generated=true

# Files that run on the Linux host or inside the image must keep LF even when
# checked out on Windows (core.autocrlf=true): a CR breaks bash and env files.
deploy/docker/** text eol=lf
deploy/offline/** text eol=lf
