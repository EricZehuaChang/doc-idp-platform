# Copy to .env and fill only the providers you use (BYOK: keys stay on this machine, never in git).
# Local dev tip: keys can also be injected via D:\Claude Code\env\load_keys.py (secrets.yaml).
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
# air-gapped: point to your own vLLM, no external key needed
LOCAL_VLLM_BASE_URL=http://localhost:8000/v1

# lite tier defaults; PG example: postgresql+asyncpg://user:pass@host/dbname
IDP_DATABASE_URL=sqlite+aiosqlite:///./data/idp.db
IDP_DATA_DIR=./data
